{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/type-aware",
    "ultracite/biome/tanstack"
  ],
  "css": {
    "parser": { "cssModules": true }
  },
  "tailwind": {
    "stylesheet": "./src/index.css"
  },
  // Keep documentation formatting outside the frontend code-quality gate.
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "javascript": {
    "globals": [
      "__API_BASE_URL__",
      "describe",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "it",
      "jest",
      "mock",
      "spyOn"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "preset": "all",
        // These actions can change runtime semantics through insertion order.
        "useSortedEnumMembers": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "all",
      "a11y": {
        "noAriaHiddenOnFocusable": "error",
        "noAutofocus": "error",
        "noInteractiveElementToNoninteractiveRole": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useHeadingContent": "error",
        "useKeyWithClickEvents": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error"
      },
      "complexity": {
        // Runner-agnostic test rules for rstest and Playwright specs.
        "noExcessiveNestedTestSuites": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 250,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noImplicitCoercions": "error",
        "noImportantStyles": "error",
        // TypeScript's noImplicitReturns requires explicit undefined returns.
        "noUselessUndefined": "off",
        // TypeScript's noPropertyAccessFromIndexSignature requires brackets.
        "useLiteralKeys": "off",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "useRegexpTest": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noNestedComponentDefinitions": "error",
        "noNodejsModules": "error",
        "noPrivateImports": {
          "level": "error",
          "options": {
            "defaultVisibility": "public"
          }
        },
        "noProcessGlobal": "error",
        // React Native's raw-text restrictions do not apply to React DOM.
        "noReactNativeRawText": "off",
        "noReactPropAssignments": "error",
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use <Button> from src/components/ui/button instead.",
              "input": "Use <Input> from src/components/ui/input instead.",
              "select": "Use <Select> or <NativeSelect> from src/components/ui instead.",
              "textarea": "Use <Textarea> from src/components/ui/textarea instead."
            }
          }
        },
        // Solid's destructured-props rule misidentifies React components.
        "noSolidDestructuredProps": "off",
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
              "**/__tests__/**",
              "**/e2e/**",
              "**/tests/**",
              "**/scripts/**",
              "**/*.config.{ts,js,mts,cts,mjs,cjs}",
              "**/playwright.config.*",
              "**/rstest.*.{ts,js,mts,cts,mjs,cjs}",
              "**/rsbuild.config.*"
            ],
            "peerDependencies": true,
            "optionalDependencies": true
          }
        },
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "error",
        "noUnresolvedImports": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": false
          }
        },
        "useJsxKeyInIterable": "error",
        "useJsonImportAttributes": "error",
        // Qwik's serialization model does not apply to React closures.
        "useQwikValidLexicalScope": "off",
        "useUniqueElementIds": "error"
      },
      "nursery": {
        // Biome 2.6 rules for this React DOM, TypeScript, and Tailwind project.
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noBaseToString": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noExcessiveStatementsPerFunction": {
          "level": "error",
          "options": { "max": 50 }
        },
        "noImpliedEval": "error",
        "noInvalidThis": "error",
        "noNegationInEqualityCheck": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noRestrictedDependencies": "error",
        "noTailwindLegacyUtilities": "error",
        // The import-aware shadcn/no-restyle rule owns registry components;
        // Biome also flags unstyled icons, router links, and local primitives.
        "noTailwindRestyledComponents": "off",
        "noUnsafePlusOperands": "error",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noZeroFractions": "error",
        "useBigintLiterals": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentJsonFileRead": "error",
        "useExhaustiveSwitchCases": "error",
        "useIncludes": "error",
        "useLowercaseTestTitle": {
          "level": "error",
          "options": {
            "allowedPrefixes": [
              "AIP ",
              "Cmd+",
              "DSN-",
              "GitHub ",
              "Go ",
              "PostgreSQL ",
              "SQL ",
              "SSL ",
              "UI-"
            ]
          }
        },
        "useMatchingFunctionName": "error",
        "useNamedFunction": "error",
        "useNullishCoalescing": "error",
        "useReactFunctionComponentDefinition": "error",
        "useSimplifiedBooleanReturn": "error",
        "useStringStartsEndsWith": "error",
        "useTailwindSortedClasses": "error",
        "useTailwindStaticClassStrings": "error",
        "useUnaryMinus": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error",
        "noDynamicNamespaceImportAccess": "error",
        // React Compiler stabilizes JSX callbacks without manual extraction.
        "noJsxPropsBind": "off",
        "noReExportAll": "error",
        // Solid's <For> component is not valid in this React application.
        "useSolidForComponent": "off",
        "useTopLevelRegex": "error",
        "useDomNodeTextContent": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "noSecrets": "error"
      },
      "style": {
        "noDoneCallback": "error",
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noEnum": "error",
        // Plain JSX text is clearer than redundant string expressions.
        "noJsxLiterals": "off",
        "noImplicitBoolean": "error",
        // Runtime geometry and chart values are passed through CSS variables.
        "noInlineStyles": "off",
        "noMagicNumbers": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod/v4": "Import from \"zod\" instead."
            }
          }
        },
        "noRestrictedTypes": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowConstantExport": true,
            "allowExportNames": [
              "DatabaseStructureMapTargetResource",
              "OtherDatabaseObject",
              "OtherObjectCategory",
              "Route",
              "resolveHomeInstanceId",
              "useCommandPalette",
              "useDb",
              "useExplorerSidebarSlotRegistration",
              "useSidebar",
              "useTheme"
            ]
          }
        },
        "useConsistentArrayType": "error",
        "useConsistentCurlyBraces": "error",
        // Rstest uses it(), while Playwright uses test().
        "useConsistentTestIt": "off",
        "useDefaultParameterLast": "error",
        "useErrorCause": "error",
        "useExportType": "error",
        "useExplicitLengthCheck": "error",
        "useExportsLast": "error",
        "useFragmentSyntax": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        // Existing numbered captures are consumed by parser/replacement APIs.
        "useNamedCaptureGroup": "off",
        // Preserve existing regex semantics; Unicode mode changes valid patterns.
        "useUnicodeRegex": "off",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useSpreadOverApply": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "strictCase": true,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "snake_case",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useSingleVarDeclarator": "error",
        "noPlaywrightWaitForSelector": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error"
      },
      "suspicious": {
        "noDuplicateTestHooks": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noBitwiseOperators": "error",
        "noConsole": "error",
        // Conditional browser capabilities and assertion helpers are intentional.
        "noConditionalExpect": "off",
        "useExpect": "off",
        // Browser support is governed by Rsbuild's targets, not CSS Baseline age.
        "useBaseline": "off",
        "noDeprecatedImports": "error",
        "noDoubleEquals": "error",
        "noEmptyInterface": "error",
        "noExplicitAny": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": true
          }
        },
        "noReturnAssign": "error",
        "noThenProperty": "error",
        "noTsIgnore": "error",
        "useDeprecatedDate": "error",
        "noDuplicateSelectors": "error",
        "noIdenticalTestTitle": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noReactStringRefs": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!**/protogen",
      "!**/components/ui",
      "!**/hooks/use-proto-form",
      "!**/lib/core",
      "!**/lib/protobuf-provider",
      "!**/dist/**/*",
      "!**/build/**/*",
      "!**/out/**/*",
      "!**/coverage/**/*",
      "!**/.nyc_output/**/*",
      "!**/playwright-report/**/*",
      "!**/routeTree.gen.ts",
      "!**/test-results/**/*"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/components/ui/**",
        "src/hooks/use-proto-form/**",
        "src/lib/core/**",
        "src/lib/protobuf-provider/**",
        "src/routeTree.gen.ts",
        "src/protogen/**"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      // Command-line scripts run under Bun and intentionally write to stdio.
      "includes": ["scripts/**/*"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "nursery": {
            // CLI wrappers intentionally propagate child-process exit statuses.
            "noProcessExit": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // Playwright, Lighthouse, and Rstest entrypoints run under Node/Bun.
      "includes": ["e2e/**/*", "lighthouserc.*", "rstest.shared.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      // Tooling config files commonly require default exports.
      "includes": [
        "*.config.{js,ts,mjs,cjs,mts,cts}",
        "**/*.config.{js,ts,mjs,cjs,mts,cts}",
        "playwright.config.*",
        "rsbuild.config.*",
        "rstest.config.*",
        "postcss.config.*"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Playwright loads custom reporters through a default export contract.
      "includes": ["e2e/llm-reporter.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Browser/runtime source code should not import Node.js modules.
      "includes": ["src/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      // Unresolved import scanner rule is useful for plain JS files.
      "includes": ["**/*.{js,jsx,mjs,cjs}"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "error"
          }
        }
      }
    },
    {
      // TanStack Router requires route components to stay private for code splitting.
      "includes": ["src/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Fake credentials and high-entropy fixtures are required test inputs;
      // Fast Refresh does not execute test modules.
      "includes": [
        "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "**/__tests__/**/*"
      ],
      "linter": {
        "rules": {
          "correctness": {
            // Rstest mock factories define replacement components once.
            "noComponentHookFactories": "off"
          },
          "nursery": {
            // Test suites contain setup and multiple assertions, unlike app logic.
            "noExcessiveStatementsPerFunction": {
              "level": "error",
              "options": { "max": 100 }
            }
          },
          "security": {
            "noSecrets": "off"
          },
          "performance": {
            // Rstest partial mocks require namespace imports with the importActual attribute.
            "noNamespaceImport": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // These static selectors and Tailwind variants are entropy false positives.
      "includes": ["src/components/querylane-ui/sidebar.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      // Payload benchmarks must include assets arriving after the UI is ready.
      "includes": ["e2e/tests/data-explorer-perf.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noPlaywrightNetworkidle": "off"
          }
        }
      }
    },
    {
      // TanStack Query owns these four-argument callback signatures.
      "includes": ["src/hooks/api/instance.ts", "src/lib/query-client.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    }
  ]
}
