        "useConsistentMemberAccessibility": "error",
        "useConsistentMethodSignatures": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useDeprecatedReason": "error",
        "useDestructuring": "error",
        "useEnumInitializers": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useExportsLast": "error",
        "useFilenamingConvention": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "error",
        "useGraphqlNamingConvention": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": "error",
        "useInputName": "error",
        "useLiteralEnumMembers": "error",
        "useLoneExecutableDefinition": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "strictCase": true,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "snake_case",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useNodeAssertStrict": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error",
        "useVueConsistentVBindStyle": "error",
        "useVueConsistentVOnStyle": "error",
        "useVueDefineMacrosOrder": "error",
        "useVueHyphenatedAttributes": "error",
        "useVueMultiWordComponentNames": "error",
        "noInlineStyles": "off",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightWaitForSelector": "error",
        "noReactNativeLiteralColors": "error",
        "noTopLevelLiterals": "error",
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "useDomQuerySelector": "error",
        "useImportsFirst": "error",
        "useNamedCaptureGroup": "error",
        "useReduceTypeParameter": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error",
        "useUnicodeRegex": "error",
        "useVarsOnTop": "error",
        "useVueConsistentDefinePropsDeclaration": "error",
        "useVueNextTickPromise": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noApproximativeNumericConstant": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noBiomeFirstException": "error",
        "noBitwiseOperators": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConsole": "error",
        "noConstEnum": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDeprecatedImports": "error",
        "noDeprecatedMediaType": "error",
        "noDocumentCookie": "error",
        "noDocumentImportInPage": "error",
        "noDoubleEquals": "error",
        "noDuplicateAtImportRules": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateCustomProperties": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noDuplicateFontNames": "error",
        "noDuplicateGraphqlOperationName": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicateProperties": "error",
        "noDuplicateSelectorsKeyframeBlock": "error",
        "noDuplicateTestHooks": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptyBlock": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyInterface": "error",
        "noEmptySource": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExportsInTest": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noHeadImportInDocument": "error",
        "noImplicitAnyLet": "error",
        "noImportAssign": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": true
          }
        },
        "noImportantInKeyframe": "error",
        "noIrregularWhitespace": "error",
        "noLabelVar": "error",
        "noLeakedRender": "off",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noMisplacedAssertion": "error",
        "noMisrefactoredShorthandAssign": "error",
        "noNestedPromises": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noOctalEscape": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noQuickfixBiome": "error",
        "noReactForwardRef": "error",
        "noReactSpecificProps": "off",
        "noRedeclare": "error",
        "noRedundantUseStrict": "error",
        "noReturnAssign": "error",
        "noSelfCompare": "error",
        "noShadow": "error",
        "noShadowRestrictedNames": "error",
        "noShorthandPropertyOverrides": "error",
        "noSkippedTests": "error",
        "noSparseArray": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noThenProperty": "error",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUndeclaredEnvVars": "error",
        "noUnknownAtRules": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noVueArrowFuncInWatch": "error",
        "noWith": "error",
        "useAdjacentOverloadSignatures": "error",
        "useArraySortCompare": "error",
        "useAwait": "off",
        "useBiomeIgnoreFolder": "error",
        "useDefaultSwitchClauseLast": "error",
        "useDeprecatedDate": "error",
        "useErrorMessage": "error",
        "useGetterReturn": "error",
        "useGoogleFontDisplay": "error",
        "useGuardForIn": "error",
        "useIsArray": "error",
        "useIterableCallbackReturn": "error",
        "useNamespaceKeyword": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useRequiredScripts": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "error",
        "noConditionalExpect": "error",
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noIdenticalTestTitle": "error",
        "noJsxLeakedDollar": "error",
        "noLoopFunc": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noReactNativeDeepImports": "error",
        "noReactStringRefs": "error",
        "noUntrustedLicenses": "error",
        "useBaseline": {
          "level": "error",
          "options": {
            "available": "newly"
          }
        },
        "useExpect": "error",
        "useScopedStyles": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.cache",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/.nyc_output",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!**/opensrc",
      "!!src/protogen",
      "!!src/components/ui",
      "!src/routeTree.gen.ts",
      "!!**/bun.lock",
      "!!**/bun.lockb"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/components/ui/**",
        "src/routeTree.gen.ts",
        "src/protogen/**"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**/*"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          },
          "nursery": {
            "noProcessExit": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*", "lighthouserc.*", "rstest.shared.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "*.config.{js,ts,mjs,cjs,mts,cts}",
        "**/*.config.{js,ts,mjs,cjs,mts,cts}",
        "playwright.config.*",
        "rsbuild.config.*",
        "rstest.config.*",
        "postcss.config.*"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/llm-reporter.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.{js,jsx,mjs,cjs}"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "error"
          }
        }
      }
    },
    {
      "includes": ["src/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "**/__tests__/**/*"
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          },
          "correctness": {
            // Retain the project check instead of the preset's test-fixture waiver.
            "noEmptyPattern": "error"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useComponentExportOnlyModules": "off"
          },
          "nursery": {
            "noExcessiveStatementsPerFunction": {
              "level": "error",
              "options": {
                "max": 100
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.jsonc", "**/tsconfig*.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ],
  "tailwind": {
    "stylesheet": "./src/index.css",
    "mergeFunctions": ["clsx", "tw", "twMerge", "cn", "twJoin"],
    "variantFunctions": ["cva", "tv"]
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    },
    "parser": {
      "frontmatter": true
    }
  }
}
