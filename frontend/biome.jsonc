{
  "extends": ["ultracite/biome/playwright"],
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "off",
        "useSortedEnumMembers": "off",
        "noDuplicateClasses": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedProperties": "off",
        "useSortedTypeFields": "on",
        "useSortedSelectionSet": "off",
        "useSortedPackageJson": "on",
        "preset": "all"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "es5"
    },
    "globals": [
      "__API_BASE_URL__",
      "describe",
      "test",
      "expect",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "it",
      "jest",
      "mock",
      "spyOn"
    ]
  },
  "css": {
    "formatter": {
      "enabled": true,
      "lineEnding": "lf",
      "lineWidth": 80,
      "quoteStyle": "double"
    },
    "parser": {
      "allowWrongLineComments": false,
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "json": {
    "assist": {
      "enabled": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingCommas": "none"
    },
    "parser": {
      "allowTrailingCommas": false
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "linter": {
    "rules": {
      "preset": "all",
      "a11y": {
        "noAccessKey": "error",
        "noAmbiguousAnchorText": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAriaUnsupportedElements": "error",
        "noAutofocus": "error",
        "noDistractingElements": "error",
        "noHeaderScope": "error",
        "noInteractiveElementToNoninteractiveRole": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveElementInteractions": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "noRedundantAlt": "error",
        "noRedundantRoles": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaActivedescendantWithTabindex": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useGenericFontNames": "error",
        "useHeadingContent": "error",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        "useKeyWithMouseEvents": "error",
        "useMediaCaption": "error",
        "useSemanticElements": "error",
        "useValidAnchor": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidAutocomplete": "error",
        "useValidLang": "error"
      },
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noDivRegex": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 250,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveNestedTestSuites": "error",
        "noExtraBooleanCast": "off",
        "noFlatMapIdentity": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noImportantStyles": "error",
        "noRedundantDefaultExport": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "off",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefined": "off",
        "noUselessUndefinedInitialization": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "off",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveSelectorClasses": "error",
        "noPlaywrightUselessAwait": "error",
        "noUnnecessaryTemplateExpression": "error",
        "useArraySome": "error",
        "useMathMinMax": "error",
        "useRegexpTest": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noConstructorReturn": "error",
        "noDuplicateArgumentNames": "error",
        "noDuplicateAttributes": "error",
        "noDuplicateEnumValueNames": "error",
        "noDuplicateInputFieldNames": "error",
        "noDuplicateVariableNames": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalDirnameFilename": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidDirectionInLinearGradient": "error",
        "noInvalidGridAreas": "error",
        "noInvalidPositionAtImportRule": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noMissingVarFunction": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noNodejsModules": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noPrivateImports": {
          "level": "error",
          "options": {
            "defaultVisibility": "public"
          }
        },
        "noProcessGlobal": "error",
        "noQwikUseVisibleTask": "error",
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use <Button> from src/components/ui/button instead.",
              "input": "Use <Input> from src/components/ui/input instead.",
              "select": "Use <Select> or <NativeSelect> from src/components/ui instead.",
              "textarea": "Use <Textarea> from src/components/ui/textarea instead."
            }
          }
        },
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSolidDestructuredProps": "off",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
              "**/__tests__/**",
              "**/e2e/**",
              "**/tests/**",
              "**/scripts/**",
              "**/*.config.{ts,js,mts,cts,mjs,cjs}",
              "**/playwright.config.*",
              "**/rstest.*.{ts,js,mts,cts,mjs,cjs}",
              "**/rsbuild.config.*",
              "src/import-meta-env.d.ts"
            ],
            "peerDependencies": true,
            "optionalDependencies": true
          }
        },
        "noUndeclaredVariables": "error",
        "noUnknownFunction": "error",
        "noUnknownMediaFeatureName": "error",
        "noUnknownProperty": "error",
        "noUnknownPseudoClass": "error",
        "noUnknownPseudoElement": "error",
        "noUnknownTypeSelector": "error",
        "noUnknownUnit": "error",
        "noUnmatchableAnbSelector": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnresolvedImports": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedInstantiation": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "noVoidTypeReturn": "error",
        "noVueDataObjectDeclaration": "error",
        "noVueDuplicateKeys": "error",
        "noVueReservedKeys": "error",
        "noVueReservedProps": "error",
        "noVueSetupPropsReactivityLoss": "error",
        "noVueVIfWithVFor": "error",
        "useExhaustiveDependencies": "error",
        "useGraphqlNamedOperations": "error",
        "useHookAtTopLevel": "error",
        "useImageSize": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": false
          }
        },
        "useInlineScriptId": "error",
        "useIsNan": "error",
        "useJsonImportAttributes": "error",
        "useJsxKeyInIterable": "error",
        "useLoneAnonymousOperation": "error",
        "useParseIntRadix": "error",
        "useQwikClasslist": "error",
        "useQwikMethodUsage": "error",
        "useQwikValidLexicalScope": "off",
        "useSingleJsDocAsterisk": "error",
        "useUniqueElementIds": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useVueVForKey": "error",
        "useVueValidTemplateRoot": "error",
        "useVueValidVBind": "error",
        "useVueValidVCloak": "error",
        "useVueValidVElse": "error",
        "useVueValidVElseIf": "error",
        "useVueValidVHtml": "error",
        "useVueValidVIf": "error",
        "useVueValidVOn": "error",
        "useVueValidVOnce": "error",
        "useVueValidVPre": "error",
        "useVueValidVText": "error",
        "useYield": "error",
        "noComponentHookFactories": "error",
        "noDuplicateFieldDefinitionNames": "error",
        "noJsxNamespace": "error",
        "noPlaywrightMissingAwait": "error",
        "noReactNativeRawText": "off",
        "noVueImportCompilerMacros": "error",
        "noVueRefAsOperand": "error",
        "noVueVOnNumberValues": "error",
        "usePlaywrightValidDescribeCallback": "error",
        "useQwikLoaderLocation": "error",
        "useReactAsyncServerFunction": "error",
        "useReactNativePlatformComponents": "error",
        "useVueValidVFor": "error"
      },
      "nursery": {
        "noConsoleSpaces": "error",
        "noMagicArrayFlatDepth": "error",
        "noNull": "off",
        "noReturnArrayPush": "error",
        "noUnreadableIife": "error",
        "noUselessRecursion": "error",
        "noVueComputedPropertiesInData": "off",
        "noVueDeprecatedDeleteSet": "off",
        "noVueDeprecatedListeners": "off",
        "noVueDeprecatedRouterLinkTagProp": "off",
        "noVueDeprecatedScopeAttribute": "off",
        "noVueMultipleSlotArgs": "off",
        "noVueMutatingProps": "off",
        "noVueSideEffectsInComputed": "off",
        "noVueUnusedRefs": "off",
        "noYamlBooleanKeys": "error",
        "useSvelteEventDispatcherTypes": "off",
        "useVueDefineOptions": "off",
        "useVueDefinePropsDestructuring": "off",
        "useVueTemplateRef": "off",
        "useVueTypedProps": "off",
        "useVueVModel": "off",
        "useVueValidDefineEmits": "off",
        "useVueValidDefineProps": "off",
        "useVueValidVIs": "off",
        "useVueValidVMemo": "off",
        "useVueValidVModel": "off",
        "useVueValidVShow": "off",
        "useVueValidVSlot": "off",
        "useWhileLoopCondition": "error",
        "noAstroConflictingSetDirectives": "error",
        "noAstroSetHtmlDirective": "error",
        "noBaseToString": "error",
        "noBunModules": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidFileInputAccept": "error",
        "noInvalidPropertyInitValue": "error",
        "noJsRestrictedProperties": "error",
        "noJsonUnsafeValues": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMisplacedListElements": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNonScalableViewport": "error",
        "noObsoleteTags": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noRestrictedDependencies": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noSvelteAtDebugTags": "error",
        "noSvelteAtHtmlTags": "error",
        "noSvelteExportLet": "error",
        "noSvelteLegacyConst": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "noTailwindArbitraryValue": "off",
        "noTailwindRawColors": "error",
        "noThisOutsideOfClass": "error",
        "noUndeclaredClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeTypeAssertion": "off",
        "noUnusedClasses": "error",
        "noUselessTypeConversion": "error",
        "noVueDeprecatedScopedSlots": "error",
        "noVueUndeclaredDirectives": "error",
        "noXorAsExponentiation": "error",
        "useAstroClientOnlyDirectiveValue": "error",
        "useAwaitThenable": "error",
        "useBetterDomTraversing": "off",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "declaration",
            "allowArrowFunctions": true
          }
        },
        "useConsistentObjectKeys": "error",
        "useControlLabel": "error",
        "useDisposables": "error",
        "useExhaustiveSwitchCases": "error",
        "useExplicitReturnType": "off",
        "useExplicitType": "off",
        "useFlatMathMinMax": "error",
        "useIncludes": "error",
        "useLayeredStyles": "off",
        "useLogicalProperties": "error",
        "useModernMathApis": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "error",
        "usePromiseRejectErrors": "error",
        "useReactCompiler": "off",
        "useReactFunctionComponentDefinition": "error",
        "useReactNamingConvention": "error",
        "useRegexpExec": "error",
        "useStrictBooleanExpressions": "error",
        "useStringStartsEndsWith": "error",
        "useSvelteKitRuneImports": "error",
        "useSvelteRequireEachKey": "error",
        "useTailwindShorthandClasses": "off",
        "useValidTestTitle": "error",
        "useVueBaseImport": "error",
        "preset": "all",
        "useTailwindSortedClasses": "error",
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noExcessiveStatementsPerFunction": {
          "level": "error",
          "options": {
            "max": 50
          }
        },
        "noInvalidThis": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noSvelteAddEventListener": "error",
        "noSvelteClassDirective": "error",
        "noSvelteInspect": "error",
        "noSvelteObjectInTextMustaches": "error",
        "noSvelteUselessDerivedBy": "error",
        "noTailwindLegacyUtilities": "error",
        "noTailwindRestyledComponents": "off",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noVueBooleanDefault": "error",
        "noVueLifecycleAfterAwait": "error",
        "noVueRequiredPropWithDefault": "error",
        "noVueRootVIf": "error",
        "noVueShadowNativeEvents": "error",
        "noVueVHtml": "error",
        "noVueVText": "error",
        "noZeroFractions": "error",
        "useBigintLiterals": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentBlockLang": "error",
        "useConsistentHeadingLevel": "off",
        "useConsistentJsonFileRead": "error",
        "useFencedCodeLanguage": "off",
        "useLowercaseTestTitle": {
          "level": "error",
          "options": {
            "allowedPrefixes": [
              "AIP ",
              "Cmd+",
              "DSN-",
              "GitHub ",
              "Go ",
              "PostgreSQL ",
              "SQL ",
              "SSL ",
              "UI-"
            ]
          }
        },
        "useMatchingFunctionName": "error",
        "useNamedFunction": "error",
        "useSimplifiedBooleanReturn": "error",
        "useSingleTopLevelHeading": "off",
        "useSvelteKitResolve": "error",
        "useSvelteReactiveClasses": "error",
        "useSvelteShorthandDirective": "error",
        "useTailwindStaticClassStrings": "error",
        "useTopLevelHeading": "off",
        "useUnaryMinus": "error",
        "useVueConsistentEventHyphenation": "error",
        "useVueMatchingComponentFileName": "error",
        "noArraySortForMinMax": "error",
        "noBooleanSortComparator": "error",
        "noDanglingUnderscore": "off",
        "noEagerArrayMethodsInLoops": "error",
        "noNewRequire": "error",
        "noObsoleteAttributes": "error",
        "noPathConcat": "error",
        "noPlaywrightNthMethods": "off",
        "noSelfNestedLayer": "error",
        "noShortTimeValues": "off",
        "noSvelteInternal": "off",
        "noTanstackQueryRestDestructuring": "error",
        "noUnreadableForOfExpression": "off",
        "noUnsafeReturn": "off",
        "noUselessSplice": "error",
        "noVueUnusedEmitDeclarations": "off",
        "noVueVTextVHtmlOnComponent": "off",
        "noVueWatchAfterAwait": "off",
        "noZeroLengthUnit": "error",
        "useBlockStatementOverIife": "error",
        "useConsistentLightnessNotation": {
          "level": "error",
          "options": {
            "notation": "number"
          }
        },
        "useConsistentUnicodeBom": "error",
        "useExpectToContain": "error",
        "useIteratorZip": "off",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "usePackageJsonValidCpu": "error",
        "usePackageJsonValidEngines": "error",
        "useReactNativeValidPlatformColors": "off",
        "useVueComponentIs": "off",
        "useVueToggleInsideTransition": "off",
        "useVueTypedRef": "off",
        "useVueVOnExact": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noDynamicNamespaceImportAccess": "error",
        "noImgElement": "error",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "error",
        "useGoogleFontPreconnect": "error",
        "useSolidForComponent": "off",
        "useTopLevelRegex": "error",
        "useVueVapor": "error",
        "useDomNodeTextContent": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 50
          }
        },
        "useIframeSandbox": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noContinue": "off",
        "noDefaultExport": "error",
        "noDescendingSpecificity": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": "off",
        "noExportedImports": "error",
        "noHeadElement": "error",
        "noHexColors": "error",
        "noImplicitBoolean": "error",
        "noIncrementDecrement": "error",
        "noInferrableTypes": "error",
        "noJsxLiterals": "off",
        "noMagicNumbers": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noRestrictedGlobals": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
