{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["@rsbuild/core/types", "node"],
    "paths": {
      "@/components/ui/*": [
        "./node_modules/.tmp/tsconfig.ui/components/ui/*",
        "./node_modules/.tmp/tsconfig.ui/src/components/ui/*"
      ],
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "allowJs": true,
    "erasableSyntaxOnly": false,
    "checkJs": true
  },
  "include": [
    "src",
    "test/setup-globals.ts",
    "*.ts",
    "*.mts",
    "*.cts",
    "*.js",
    "*.mjs",
    "*.cjs",
    "e2e",
    "scripts",
    "public/**/*.js"
  ],
  "references": [
    {
      "path": "./tsconfig.declarations.json"
    }
  ],
  "exclude": ["opensrc", "src/components/ui"]
}
