{
  "name": "@querylane/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget:check": "bun run scripts/check-bundle-budget.ts",
    "build": "rsbuild build && bun run budget:check",
    "build:profile": "rm -rf dist && RSDOCTOR=1 rsbuild build",
    "changeset": "changeset",
    "changeset:tag": "changeset git-tag",
    "changeset:version": "changeset version",
    "check": "bun run quality:gate",
    "dev": "rsbuild dev",
    "dev:scan": "QUERYLANE_REACT_SCAN=1 bun run dev",
    "doctor": "react-doctor . -y --scope full --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "doctor:audit": "bun run doctor",
    "doctor:changed": "react-doctor . -y --scope changed --base ${QUALITY_BASE_REF:-origin/main} --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "doctor:ci": "bun run doctor:full",
    "doctor:dead-code": "react-doctor . -y --scope full --no-lint --blocking warning --no-respect-inline-disables --no-score",
    "doctor:full": "react-doctor . -y --scope full --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "fix": "bun run lint:fix",
    "format": "bun run lint:fix",
    "format:write": "biome format --write .",
    "postinstall": "bun run type:check:ui",
    "lighthouse:autorun": "lhci autorun --config lighthouserc.cjs",
    "lighthouse:ci": "bun run scripts/run-lighthouse-ci.ts",
    "lighthouse:public": "LIGHTHOUSE_RUNS=1 LIGHTHOUSE_UPLOAD_TARGET=temporary-public-storage bun run scripts/run-lighthouse-ci.ts",
    "lighthouse:summary": "bun run scripts/lighthouse-summary.ts ./dist/lighthouse",
    "lint": "bun run quality:rules && ultracite check && bun run lint:shadcn && bun run suppressions:check",
    "lint:biome": "biome check .",
    "lint:changed": "bun run scripts/lint-changed.ts && bun run lint:shadcn && bun run suppressions:check",
    "lint:fix": "biome format --write . && ultracite fix && bun run lint:shadcn && bun run suppressions:check",
    "lint:oxlint": "oxlint --config oxlint.config.ts --type-aware --deny-warnings --disable-nested-config --report-unused-disable-directives-severity error",
    "lint:shadcn": "bun run lint:oxlint",
    "perf:check": "bun run scripts/perf-budgets.ts",
    "perf:lighthouse": "bun run build && bun run lighthouse:ci && bun run lighthouse:summary",
    "perf:lighthouse:public": "bun run build && bun run lighthouse:public",
    "preview": "rsbuild preview",
    "quality:changed": "bun run lint:changed && bun run doctor:changed && bun run type:check && bun run test:unit:changed && bun run test:integration:changed && bun run test:browser:changed",
    "quality:gate": "bun run lint && bun run doctor && bun run type:check && bun run build && bun run test:unit && bun run test:integration",
    "suppressions:check": "bun run scripts/check-suppressions.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:accessibility": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --project=chromium --grep @a11y",
    "test:browser": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --bail=1 && NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.dark.config.ts --bail=1",
    "test:browser:changed": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1 && NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.dark.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:browser:ci": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --bail=1 && NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.dark.config.ts --bail=1",
    "test:browser:setup": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright install --with-deps --no-remove chromium",
    "test:browser:ui": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest watch --config rstest.browser.config.ts --browser.headless=false",
    "test:docs": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/docs.config.ts",
    "test:e2e": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --project=chromium --grep-invert @a11y",
    "test:e2e:ci": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --project=chromium --workers=1",
    "test:e2e:debug": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:debug:cli": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --debug=cli",
    "test:e2e:list": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --list --reporter=list",
    "test:e2e:profile": "bun run test:e2e --add-reporter=perfetto",
    "test:e2e:repeat": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --project=chromium --grep-invert @a11y --repeat-each=2",
    "test:e2e:ui": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --ui",
    "test:integration": "rstest --config rstest.integration.config.ts --bail=1",
    "test:integration:changed": "rstest --config rstest.integration.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:integration:ci": "rstest --config rstest.integration.config.ts --bail=1",
    "test:integration:leaks": "rstest --config rstest.integration.config.ts --detectAsyncLeaks --bail=1",
    "test:integration:watch": "rstest watch --config rstest.integration.config.ts",
    "test:unit": "rstest --config rstest.unit.config.ts --bail=1",
    "test:unit:changed": "rstest --config rstest.unit.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:unit:ci": "rstest --config rstest.unit.config.ts --bail=1",
    "test:unit:watch": "rstest watch --config rstest.unit.config.ts",
    "test:visual": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --project=visual-light --project=visual-dark",
    "test:visual:container": "bash scripts/playwright-container.sh bun run test:visual",
    "test:visual:update": "bash scripts/playwright-container.sh bun run test:visual --update-snapshots=changed",
    "type:check": "bun run type:check:ui && tsrs -p tsconfig.node.json --pretty false && tsrs -p tsconfig.browser-js.json --pretty false && tsrs -b tsconfig.declarations.json --pretty false && tsrs -p tsconfig.json --incremental false --pretty false && bun run type:check:canary",
    "type:check:canary": "tsc -p tsconfig.ui.json --outDir node_modules/.tmp/tsconfig.ui-canary --pretty false && tsc -p tsconfig.node.json --pretty false && tsc -p tsconfig.browser-js.json --pretty false && tsc -b tsconfig.declarations.json --pretty false && tsc -p tsconfig.json --incremental false --pretty false",
    "type:check:ui": "tsrs -p tsconfig.ui.json --pretty false",
    "quality:rules": "bun run scripts/check-rule-inventory.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@buf/googleapis_googleapis.bufbuild_es": "2.16.0-20261015202054-8ac61b9e5023.1",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-query-core": "2.3.1",
    "@connectrpc/connect-web": "2.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@lezer/highlight": "1.2.5",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@standard-schema/spec": "1.1.0",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/router-plugin": "1.168.48",
    "@tanstack/virtual-core": "3.19.8",
    "@xyflow/react": "12.12.0",
    "chrono-node": "2.10.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.63.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-data-grid": "7.0.0-beta.63",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-resizable-panels": "4.15.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "sql-formatter": "15.9.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@lhci/cli": "0.15.1",
    "@rsbuild/core": "2.3.0",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@rsdoctor/core": "2.0.1",
    "@rsdoctor/shared": "2.0.1",
    "@rstest/browser": "0.12.5",
    "@rstest/browser-react": "0.12.5",
    "@rstest/core": "0.12.5",
    "@shadcn/lint": "0.2.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "expect-type": "1.4.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "react-doctor": "0.9.18",
    "react-scan": "0.5.7",
    "rsbuild-plugin-devtools-json": "1.0.1",
    "shadcn": "4.23.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tw-animate-css": "1.4.0",
    "typescript": "7.1.0-dev.20261028.1",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.15.0"
  }
}
