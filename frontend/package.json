{
  "name": "@querylane/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget:check": "bun run scripts/check-bundle-budget.ts",
    "build": "rsbuild build && bun run budget:check",
    "build:profile": "rm -rf dist && RSDOCTOR=1 rsbuild build",
    "changeset": "changeset",
    "changeset:tag": "changeset tag",
    "changeset:version": "changeset version",
    "check": "bun run lint",
    "dev": "rsbuild dev",
    "dev:scan": "QUERYLANE_REACT_SCAN=1 bun run dev",
    "doctor": "react-doctor . -y --scope full --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "doctor:audit": "bun run doctor",
    "doctor:changed": "react-doctor . -y --scope changed --base ${QUALITY_BASE_REF:-origin/main} --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "doctor:ci": "bun run doctor:changed",
    "doctor:dead-code": "react-doctor . -y --scope full --no-lint --blocking warning --no-respect-inline-disables --no-score",
    "doctor:full": "react-doctor . -y --scope full --blocking warning --no-respect-inline-disables --supply-chain --no-score",
    "fix": "bun run lint:fix",
    "format": "bun run lint:fix",
    "postinstall": "if [ \"$NODE_ENV\" = \"production\" ] || [ \"$npm_config_production\" = \"true\" ] || ! command -v tsc >/dev/null 2>&1; then exit 0; fi; bun run type:check:ui",
    "lighthouse:autorun": "lhci autorun --config lighthouserc.cjs",
    "lighthouse:ci": "bun run scripts/run-lighthouse-ci.ts",
    "lighthouse:public": "LIGHTHOUSE_RUNS=1 LIGHTHOUSE_UPLOAD_TARGET=temporary-public-storage bun run scripts/run-lighthouse-ci.ts",
    "lighthouse:summary": "bun run scripts/lighthouse-summary.ts ./dist/lighthouse",
    "lint": "ultracite check && bun run lint:shadcn && bun run suppressions:check",
    "lint:changed": "bun run scripts/lint-changed.ts && bun run lint:shadcn && bun run suppressions:check",
    "lint:fix": "ultracite fix && bun run lint:shadcn && bun run suppressions:check",
    "lint:shadcn": "oxlint --config oxlint.config.ts --deny-warnings",
    "perf:check": "bun run scripts/perf-budgets.ts",
    "perf:lighthouse": "bun run build && bun run lighthouse:ci && bun run lighthouse:summary",
    "perf:lighthouse:public": "bun run build && bun run lighthouse:public",
    "preview": "rsbuild preview",
    "quality:changed": "bun run lint:changed && bun run doctor:changed && bun run type:check && bun run test:unit:changed && bun run test:integration:changed && bun run test:browser:changed",
    "quality:gate": "bun run lint && bun run doctor && bun run type:check && bun run build && bun run test:unit && bun run test:integration",
    "suppressions:check": "bun run scripts/check-suppressions.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:accessibility": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --grep @a11y",
    "test:browser": "bun run test:browser:rstest && bun run test:browser:vitest",
    "test:browser:changed": "bun run test:browser:rstest:changed && bun run test:browser:vitest:changed",
    "test:browser:ci": "bun run test:browser:rstest:ci && bun run test:browser:vitest:ci",
    "test:browser:rstest": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --bail=1",
    "test:browser:rstest:changed": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1 && NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.dark.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:browser:rstest:ci": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.config.ts --bail=1 && NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest --config rstest.browser.dark.config.ts --bail=1",
    "test:browser:rstest:ui": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT rstest watch --config rstest.browser.config.ts --browser.headless=false",
    "test:browser:setup": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright install --with-deps --no-remove chromium",
    "test:browser:ui": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT vitest --config vitest.browser.config.ts --ui",
    "test:browser:update": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT vitest run --config vitest.browser.config.ts --update",
    "test:browser:vitest": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT vitest run --config vitest.browser.config.ts",
    "test:browser:vitest:changed": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT vitest run --config vitest.browser.all.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests",
    "test:browser:vitest:ci": "NODE_OPTIONS=--disable-warning=DEP0205 TZ=GMT vitest run --config vitest.browser.all.config.ts --reporter=verbose",
    "test:e2e": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --grep-invert @a11y",
    "test:e2e:debug": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:debug:cli": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --debug=cli",
    "test:e2e:list": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --list --reporter=list",
    "test:e2e:profile": "bun run test:e2e --add-reporter=perfetto",
    "test:e2e:repeat": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --grep-invert @a11y --repeat-each=2",
    "test:e2e:ui": "env -u NO_COLOR NODE_OPTIONS=--disable-warning=DEP0205 playwright test --config=e2e/playwright.config.ts --ui",
    "test:integration": "rstest --config rstest.integration.config.ts --bail=1",
    "test:integration:changed": "rstest --config rstest.integration.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:integration:ci": "rstest --config rstest.integration.config.ts --bail=1",
    "test:integration:leaks": "rstest --config rstest.integration.config.ts --detectAsyncLeaks --bail=1",
    "test:integration:watch": "rstest watch --config rstest.integration.config.ts",
    "test:unit": "rstest --config rstest.unit.config.ts --bail=1",
    "test:unit:changed": "rstest --config rstest.unit.config.ts --changed ${QUALITY_BASE_REF:-origin/main} --passWithNoTests --bail=1",
    "test:unit:ci": "rstest --config rstest.unit.config.ts --bail=1",
    "test:unit:watch": "rstest watch --config rstest.unit.config.ts",
    "type:check": "bun run type:check:ui && tsc -p tsconfig.node.json --pretty false && tsc -b --pretty false",
    "type:check:ui": "tsc -p tsconfig.ui.json --pretty false"
  },
  "overrides": {
    "react-doctor": "0.9.14"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@bufbuild/protobuf": "2.15.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "2.2.0",
    "@connectrpc/connect-query-core": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/router-plugin": "1.168.23",
    "@tanstack/virtual-core": "3.17.7",
    "@xyflow/react": "12.11.2",
    "chrono-node": "2.10.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "lucide-react": "1.47.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.12.2",
    "shiki": "4.3.1",
    "sonner": "2.0.7",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.2-2d3cb18.0",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "2.31.1",
    "@lhci/cli": "0.15.1",
    "@rsbuild/core": "2.2.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@rsdoctor/core": "1.6.4",
    "@rsdoctor/graph": "1.6.4",
    "@rsdoctor/rspack-plugin": "1.6.4",
    "@rsdoctor/types": "1.6.4",
    "@rstest/browser": "0.12.0",
    "@rstest/browser-react": "0.12.0",
    "@rstest/core": "0.12.0",
    "@shadcn/lint": "0.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.0-beta.7",
    "@vitest/browser-playwright": "5.0.0-beta.7",
    "@vitest/ui": "5.0.0-beta.7",
    "expect-type": "1.4.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.83.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "react-doctor": "0.9.14",
    "react-scan": "0.5.7",
    "rsbuild-plugin-devtools-json": "1.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.0-beta.7",
    "vitest-browser-react": "2.2.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  }
}
