# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM oven/bun:1.4.4-alpine AS native-bun

# Build native SSR dependencies for the final image's platform, including sharp.
FROM oven/bun:1.4.4-alpine AS builder

WORKDIR /app

# Only build/verification stages need Git; the runtime ships neither Git nor history.
RUN apk add --no-cache git
COPY --from=docs-git / /app/.git

COPY package.json bun.lock ./
COPY patches ./patches
RUN --mount=type=cache,target=/root/.bun/install/cache \
	bun install --frozen-lockfile --ignore-scripts

COPY blume.config.ts ./
COPY components.ts ./
COPY examples ./examples
COPY theme.css ./
COPY docs/components ./docs/components
COPY docs/generated ./docs/generated
COPY docs/fonts ./docs/fonts
COPY docs/site ./docs/site
COPY public ./public
COPY proto ./proto
COPY scripts/docs-content.test.ts ./scripts/docs-content.test.ts
COPY scripts/docs-runtime.spec.ts ./scripts/docs-runtime.spec.ts
COPY scripts/docs-fonts.ts ./scripts/docs-fonts.ts
COPY scripts/docs-package.ts ./scripts/docs-package.ts
COPY scripts/docs-package.test.ts ./scripts/docs-package.test.ts
COPY scripts/docs-dependencies.test.ts ./scripts/docs-dependencies.test.ts

RUN bun run docs:test:content
RUN bun run docs:check
RUN bun run docs:validate
RUN bun run docs:build
RUN bun run docs:audit
RUN bun run docs:package /runtime

# Run CPU-bound tooling regressions natively: their watchdogs exclude QEMU cost.
# Keep the target install intact for the runtime verification below.
FROM --platform=$BUILDPLATFORM node:24-alpine AS tooling-verified
WORKDIR /app
COPY --from=native-bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=builder /app /app
RUN bun test scripts/docs-package.test.ts scripts/docs-dependencies.test.ts

# Verify the built site using the same Node version as the deployed server.
FROM node:24-alpine AS verified
RUN apk add --no-cache git
WORKDIR /app
COPY --from=builder /usr/local/bin/bun /usr/local/bin/bun
COPY --from=tooling-verified /app /app
# Outside /app: missing runtime dependencies cannot fall back to the build install.
COPY --from=builder /runtime /runtime
RUN DOCS_RUNTIME_ROOT=/runtime bun run docs:test:runtime

FROM node:24-alpine

WORKDIR /app

ENV HOST=0.0.0.0
ENV PORT=80

COPY --from=verified --chown=node:node /runtime ./

USER node

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
	CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["node", "./dist/server/entry.mjs"]
