---
import specs from "blume:openapi";
import NavTree from "blume/components/layout/NavTree.astro";
import type { UIStrings } from "blume/core/i18n-ui.ts";
import type { NavNode } from "blume/core/types.ts";
import {
  rpcPresentationForReference,
  withRpcBadges,
} from "./rpc-kind.ts";

interface Props {
  items: NavNode[];
  currentRoute: string;
  strings?: UIStrings["nav"];
  ids?: Map<NavNode, string>;
  fragmentBase?: string;
}

const { items, currentRoute, strings, ids, fragmentBase } = Astro.props;
const labelsByRoute = new Map<string, string>();

for (const spec of Object.values(specs)) {
  for (const operation of Object.values(spec.operations)) {
    labelsByRoute.set(
      operation.route,
      rpcPresentationForReference(spec.document, operation).label
    );
  }
}

const rpcItems = withRpcBadges(items, labelsByRoute);
// Blume's deferred fragments render the original tree, without RPC badges.
// Keep customized sections eager; untouched trees retain their stable IDs
// and can use upstream deferred navigation without losing badge semantics.
const unchanged = rpcItems === items;
---

<NavTree
  currentRoute={currentRoute}
  fragmentBase={unchanged ? fragmentBase : undefined}
  ids={unchanged ? ids : undefined}
  items={rpcItems}
  strings={strings}
/>
