{
  "name": "querylane",
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/node": "26.6.5",
    "blume": "2.2.7",
    "node-html-parser": "9.0.7"
  },
  "packageManager": "bun@1.4.4",
  "private": true,
  "scripts": {
    "docs:api:generate": "buf generate --template buf.openapi.gen.yaml && bun scripts/finalize-openapi.ts",
    "docs:audit": "blume audit",
    "docs:build": "blume build --strict",
    "docs:check": "blume check --strict",
    "docs:dev": "blume dev",
    "docs:diagrams:generate": "bun scripts/generate-doc-diagram-themes.ts",
    "docs:eval": "blume eval --agent codex --json",
    "docs:test": "bun test scripts/docs-*.test.ts",
    "docs:test:browser": "bun run --cwd frontend test:docs",
    "docs:test:content": "bun test scripts/docs-content.test.ts",
    "docs:test:runtime": "bun test scripts/docs-runtime.spec.ts",
    "docs:validate": "blume validate --strict",
    "setup:worktree": "bun ./scripts/setup-worktree.mjs"
  },
  "type": "module",
  "patchedDependencies": {
    "blume@2.2.7": "patches/blume@2.2.7.patch"
  }
}
